{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "A post's journey",
    "locale": "en",
    "output": "app/public/learn/post-lifecycle.html",
    "quality_profile": "showcase"
  },
  "mainPath": [
    "pending",
    "loading",
    "describing",
    "checking",
    "indexing",
    "published"
  ],
  "states": [
    {
      "id": "pending",
      "type": "start",
      "label": "Pending",
      "sublabel": "POST /api/posts",
      "tag": "202",
      "step": "01"
    },
    {
      "id": "loading",
      "type": "active",
      "label": "Load post",
      "sublabel": "Workflow starts",
      "tag": "workflow",
      "step": "02"
    },
    {
      "id": "describing",
      "type": "active",
      "label": "Describe photo",
      "sublabel": "vision model",
      "tag": "photo posts",
      "step": "03"
    },
    {
      "id": "checking",
      "type": "decision",
      "label": "Safety check",
      "sublabel": "Llama Guard",
      "tag": "2 retries",
      "step": "04"
    },
    {
      "id": "indexing",
      "type": "active",
      "label": "Index for search",
      "sublabel": "Vectorize",
      "tag": "best effort",
      "step": "05"
    },
    {
      "id": "published",
      "type": "success",
      "label": "Published",
      "sublabel": "shown in the feed",
      "tag": "done",
      "step": "06"
    },
    {
      "id": "retrying",
      "type": "failure",
      "label": "Check failed",
      "sublabel": "retries twice",
      "tag": "retryable"
    },
    {
      "id": "rejected",
      "type": "failure",
      "label": "Rejected",
      "sublabel": "kept out of the feed",
      "tag": "final"
    },
    {
      "id": "waiting",
      "type": "waiting",
      "label": "Waiting for admin",
      "sublabel": "post stays pending",
      "tag": "pause"
    }
  ],
  "transitions": [
    {
      "id": "pending-loading",
      "from": "pending",
      "to": "loading",
      "label": "start"
    },
    {
      "id": "loading-describing",
      "from": "loading",
      "to": "describing",
      "label": "loaded"
    },
    {
      "id": "describing-checking",
      "from": "describing",
      "to": "checking",
      "label": "text + photo"
    },
    {
      "id": "checking-indexing",
      "from": "checking",
      "to": "indexing",
      "label": "safe"
    },
    {
      "id": "indexing-published",
      "from": "indexing",
      "to": "published",
      "label": "publish"
    },
    {
      "id": "check-fails",
      "from": "checking",
      "to": "retrying",
      "label": "check fails",
      "variant": "security"
    },
    {
      "id": "retry",
      "from": "retrying",
      "to": "checking",
      "label": "retry",
      "variant": "emphasis"
    },
    {
      "id": "unsafe",
      "from": "checking",
      "to": "rejected",
      "label": "unsafe",
      "variant": "security"
    },
    {
      "id": "not-described",
      "from": "checking",
      "to": "waiting",
      "label": "photo not described",
      "variant": "security"
    },
    {
      "id": "retries-used-up",
      "from": "retrying",
      "to": "waiting",
      "label": "retries used up",
      "variant": "security"
    },
    {
      "id": "admin-publishes",
      "from": "waiting",
      "to": "published",
      "label": "admin publishes",
      "variant": "dashed"
    },
    {
      "id": "admin-rejects",
      "from": "waiting",
      "to": "rejected",
      "label": "admin rejects",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "From post to published",
      "items": [
        "Saved as pending; the API answers 202 right away and the Workflow does the rest",
        "A vision model describes the photo, Llama Guard checks it with the title and body, then the post gets a search entry and is published",
        "The Composer polls every 2 s for about 30 s; a post still pending after that waits for the owner"
      ]
    },
    {
      "dot": "rose",
      "title": "When the check fails",
      "items": [
        "It retries twice, waiting 10 s then longer; each try gets 2 minutes",
        "Finished steps are saved, so a retry doesn't redo them",
        "Unsafe: rejected, with the flagged categories saved as a note"
      ]
    },
    {
      "dot": "amber",
      "title": "Waiting for the owner",
      "items": [
        "The row stays pending if the photo can't be described (with a note), the retries run out or the Workflow can't start",
        "The owner can Publish or Reject on the Admin page; the Workflow only changes posts that are still pending, so it never overwrites that choice",
        "Locally, without Workers AI, posts are published with the note 'Published without AI checks (local dev)'",
        "Free: 3,000 Workflow steps a day; a post uses up to 5"
      ]
    }
  ]
}
