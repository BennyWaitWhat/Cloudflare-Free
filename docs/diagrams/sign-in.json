  "cards": [
    {
      "dot": "cyan",
      "title": "Passkeys, no passwords",
      "items": [
        "The device keeps the private key; D1 stores only the public key",
        "Signatures fit the 10 ms CPU limit; password hashing would not"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cookies, not sessions",
      "items": [
        "One-time challenge (5 min) and session (30 days) live in signed cookies",
        "Each later request reads one D1 row, writes none (5M reads a day free)"
      ]
    },
    {
      "dot": "violet",
      "title": "Who gets checked",
      "items": [
        "Only sign-up uses Turnstile (free, unlimited challenges)",
        "Sign-up and sign-in: 10 tries a minute per IP"
      ]
    }
