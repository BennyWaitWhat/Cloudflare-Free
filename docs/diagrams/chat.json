    {
      "id": "c-ws",
      "from": "browser",
      "to": "worker",
      "y": 164,
      "label": "WebSocket /api/chat/:room/ws",
      "variant": "emphasis"
    },
    {
      "id": "c-fetch",
      "from": "worker",
      "to": "room",
      "y": 192,
      "label": "getByName(room).fetch",
      "variant": "emphasis"
    },
