  "cards": [
    {
      "dot": "cyan",
      "title": "One object per room",
      "items": [
        "Four rooms (lobby, showcase, help, off-topic), one Durable Object each",
        "The Worker adds x-chat-user from your session; guests can read, not send"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hibernation keeps it free",
      "items": [
        "Durable Objects free: 100,000 requests and 13,000 GB-s a day",
        "Idle rooms leave memory while sockets stay open, so no GB-s are spent"
      ]
    },
    {
      "dot": "violet",
      "title": "Small and tidy",
      "items": [
        "setWebSocketAutoResponse replies to pings without waking the room",
        "Limits: 500 characters and 1 message a second per member, across all their tabs; about 200 kept",
        "Each member keeps up to 3 tabs open in a room; a 4th closes their oldest",
        "Sockets silent for 75 s are closed, so the online count stays honest"
      ]
    }
