      "label": "ChatRoom",
      "sublabel": "CHAT_ROOM, one per room"
    },
    {
      "id": "sql",
      "type": "database",
      "label": "SQLite",
      "sublabel": "messages table"
    },
    {
      "id": "everyone",
      "type": "external",
      "label": "Everyone",
      "sublabel": "all open sockets"
    }
  ],
  "segments": [
