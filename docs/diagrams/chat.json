{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Live chat in a Durable Object",
    "locale": "en",
    "output": "app/public/learn/chat.html",
    "quality_profile": "showcase",
    "viewBox": [1060, 626],
    "column_fit": "spread"
