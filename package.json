{
  "name": "cloudflare-free",
  "version": "0.1.0",
  "private": true,
  "description": "A website + installable web app built only from Cloudflare's free tier, using every free offering it can.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:remote": "vite dev --mode remote",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply cloudflare-free --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloudflare-free --remote"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.13",
    "postal-mime": "^4.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
