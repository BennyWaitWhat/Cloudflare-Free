# Copy to .dev.vars for local development (it is git-ignored).
# In production set these with `npx wrangler secret put <NAME>`.

# Any random string of 32+ characters, e.g. from `node -e "console.log(crypto.randomBytes(48).toString('base64'))"`
SESSION_SECRET=replace-with-a-long-random-string

# Cloudflare's published always-pass Turnstile test secret. Use your widget's real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Usernames that get the admin role locally.
ADMIN_USERNAMES=owner
