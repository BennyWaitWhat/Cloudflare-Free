# Headers for the static files, on workers.dev and custom domains alike. They don't apply to
# responses from the Worker itself, such as /api and /img.

# Hashed bundles never change, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Turnstile and Web Analytics are the only scripts from elsewhere. Inline scripts are blocked, including
# any that Cloudflare injects on the domain, such as Bot Fight Mode's JavaScript detections; those
# need a per-request nonce, which a static file can't add.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The diagram pages run their own inline scripts, which the policy above would block.
/learn/*
  ! Content-Security-Policy
