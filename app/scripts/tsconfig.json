{
  // Node-side code: these scripts, plus vite.config.ts and vitest.config.ts in the repo root.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [".", "../vite.config.ts", "../vitest.config.ts"]
}
